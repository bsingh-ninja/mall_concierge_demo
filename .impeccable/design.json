  "narrative": {
    "northStar": "The Quiet Floor Plan",
    "overview": "The map is the app. A light grey floor, white units, grey line icons and store names wherever they fit: this is the one rich object on every screen, executed to the category standard of indoor mapping. Everything around it is distilled to strict minimalism. Neutral greys and white carry the chrome; one blue marks the single primary action and the route; one red appears only for a crowd surge, always beside words.\n\nThere are no cards, no drop shadows, no borders or dividers in the interface chrome. Hierarchy comes from whitespace and four type sizes alone. Lists are plain rows; secondary actions are underlined text; the plan, the walk and the reroute live in one flat white sheet pulled up over the map. The operator console reuses the same map as a footfall heat field and reads as a working tool: plain tables, large tabular figures, and the agent log as text.\n\nDensity is calm and projector-proof. Numbers are always tabular; every price, time and percentage aligns.",
    "keyCharacteristics": [
      "One labelled indoor map per screen, flat and full-bleed on the phone.",
      "Neutral greys and white; blue for the action and the route; red only for the surge, with text.",
      "Four interface sizes (13 / 15 / 20 / 32), weights 400 / 500 / 600, Inter with tabular figures.",
      "Flat white surfaces separated by space and tone, never by line or shadow.",
      "One filled primary action per screen; everything else is text."
    ],
    "rules": [
      {
        "name": "The One Blue Rule",
        "body": "Route Blue marks the one primary action, the route and the shopper's position. It is never decoration, never a heading colour, never a second button.",
        "section": "colors"
      },
      {
        "name": "The Red Speaks Rule",
        "body": "Surge Red appears only for crowding and its consequences, and always next to a sentence that names the cause (\"Saffron House is 98% full, 32 min wait\").",
        "section": "colors"
      },
      {
        "name": "The Four Sizes Rule",
        "body": "Interface text uses 13, 15, 20 or 32px and nothing else. Map labels live on the map's own scale and do not count.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every price, time, distance, count and percentage is set with tabular figures.",
        "section": "typography"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "Surfaces over the map are separated from it by colour and position, never by shadow, border or blur.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the labelled map visible on every shopper screen; the sheet covers part of it, never all of it.",
      "**Do** use exactly one filled Route Blue pill per screen and make every other action text.",
      "**Do** separate sections with 24 to 40px of space and type size, not with lines or boxes.",
      "**Do** set every number in tabular figures.",
      "**Do** pair every use of Surge Red with a sentence naming the crowding.",
      "**Do** use outlines on map units to carry state (stop, surge, selected, below target); that is the map's native language.",
      "**Do** honour reduced motion: the route appears fully drawn and animations collapse to instant."
    ],
    "donts": [
      "**Don't** add cards, drop shadows, borders or dividers to the interface chrome.",
      "**Don't** use Route Blue for headings, decoration or a second button.",
      "**Don't** introduce type sizes outside 13 / 15 / 20 / 32 in the interface, or weights above 600.",
      "**Don't** fill map units with category colours; units are white, identity comes from the grey icon and the name.",
      "**Don't** stack map tags or labels; a tag with no clear spot is dropped."
    ]
  }
}